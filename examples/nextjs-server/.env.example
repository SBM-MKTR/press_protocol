# Neon / Postgres database URL for persistent articles, reads, payments, and unlocks
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public app URL used by TonConnect manifest generation and Telegram Mini App deployment.
# Use the exact origin judges will open in Telegram, with no trailing slash.
NEXT_PUBLIC_APP_URL=https://your-deployment.vercel.app

# Telegram Mini App return URL used by TonConnect when the app is opened inside Telegram.
# This should be the Telegram deep link that reopens your Mini App, for example:
# NEXT_PUBLIC_TWA_RETURN_URL=https://t.me/your_bot/your_app
NEXT_PUBLIC_TWA_RETURN_URL=https://t.me/your_bot/your_app

# TON network: "testnet" or "mainnet"
TON_NETWORK=testnet

# Your wallet address (where you receive payments)
PAYMENT_ADDRESS=your_ton_wallet_address_here

# Jetton master contract address (BSA USD on testnet)
JETTON_MASTER_ADDRESS=kQCd6G7c_HUBkgwtmGzpdqvHIQoNkYOEE0kSWoc5v57hPPnW

# Facilitator URL (You can use the BSA Facilitator if you don't want to run your own)
FACILITATOR_URL=http://localhost:3000/api/facilitator
#FACILITATOR_URL=https://ton-x402-nextjs-server-lqa1jowhn-hliosones-projects.vercel.app/api/facilitator

# TON RPC (get a free API key at https://toncenter.com)
TON_RPC_URL=https://testnet.toncenter.com/api/v2/jsonRPC
RPC_API_KEY=your_toncenter_api_key_here

# Client wallet mnemonic (24 words), used by the client-script to pay endpoints
# Get a testnet wallet on Tonkeeper (switch to testnet mode)
WALLET_MNEMONIC="word1 word2 word3 ... word24"

# After creating .env.local, initialize the database:
# pnpm db:migrate
# pnpm db:seed
